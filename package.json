{
  "name": "bangtu-open-mcp",
  "version": "1.0.0",
  "description": "BangTu Open API MCP server over Streamable HTTP and SSE",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prestart": "node -e \"import('dotenv').catch(() => { console.error('Runtime dependencies are missing. Run npm ci before npm start.'); process.exit(1); })\"",
    "start": "node dist/index.js",
    "build": "node scripts/build.mjs production",
    "build:test": "node scripts/build.mjs test",
    "build:inner": "node scripts/build.mjs inner",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
