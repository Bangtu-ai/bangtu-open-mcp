# MCP server
PORT=3000
HOST=0.0.0.0
JSON_LIMIT=10mb

# BangTu Open API
# Official API base URL. This value is already correct for the published API.
BANGTU_API_BASE_URL=https://openapi.bangtu-ai.com/openApi/
# API keys are supplied per MCP tool call by each customer. Do not put customer keys here.

# Task polling behavior
# Recommended interval is 3-5 seconds.
BANGTU_POLL_INTERVAL_MS=5000
# Complex DWG drawings can take up to 120 minutes.
BANGTU_MAX_TASK_DURATION_MINUTES=120
# bangtu_wait_task defaults and hard cap. Keep these below the Agent client's tool timeout.
# Long-running jobs should call bangtu_wait_task repeatedly or use bangtu_get_task_status.
BANGTU_DEFAULT_WAIT_SECONDS=20
BANGTU_MAX_WAIT_SECONDS=45
